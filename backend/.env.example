# ===========================================
# VieScanner Backend - Environment Variables
# ===========================================
# Copy this file to `.env` and fill real values.
# Never commit `.env` to git.

# ----- App -----
APP_NAME=VieScanner API
APP_VERSION=1.0.0
DEBUG=true

# ----- CORS -----
CORS_ORIGINS_RAW=http://localhost:3000

# ----- Upload limits -----
# Tổng dung lượng 1 request (mọi file gộp lại); frontend dùng NEXT_PUBLIC_MAX_REQUEST_MB, đặt bằng nhau.
MAX_REQUEST_MB=100
MAX_UPLOAD_SIZE_MB=5
ALLOWED_MIME_TYPES_RAW=image/jpeg,image/png,image/webp

# ----- OCR engine -----
OCR_ENGINE=mock
OCR_DEVICE=auto
OCR_MODEL_DIR=weights
OCR_ALIGNER_CONF_THRESHOLD=0.25
OCR_ALIGNER_RETRY_CONF_THRESHOLDS_RAW=0.15,0.10,0.05
# Tìm thẻ theo đường viền khi YOLO thiếu góc hoặc tứ giác méo.
OCR_ALIGNER_CONTOUR_FALLBACK=true
OCR_DETECTOR_MODEL=PP-OCRv5_server_det
OCR_DETECTOR_CONF_THRESHOLD=0.30
OCR_DETECTOR_PADDING=4
OCR_CLEANER_SHADOW_KERNEL_SIZE=7
OCR_CLEANER_CLIP_HIST_PERCENT=1.0
OCR_RECOGNIZER_MODEL=vgg_transformer
OCR_RECOGNIZER_BEAMSEARCH=true
# Nhận dạng cả batch box trong 1 lần gọi VietOCR (predict_batch) -> nhanh hơn.
# LƯU Ý: batch=true dùng greedy decoding (bỏ qua beamsearch) nhưng trả confidence
# thật cho mỗi dòng. Đặt false nếu muốn ưu tiên độ chính xác của beamsearch.
OCR_RECOGNIZER_BATCH=true
OCR_EXTRACTOR_FUZZY_THRESHOLD=80
OCR_DEBUG_SAVE=false
OCR_MAX_IMAGE_SIDE_PX=2000
# Số request OCR chạy song song. Model dùng chung KHÔNG thread-safe -> để 1 cho
# an toàn (đặc biệt GPU 4GB). Tăng nếu CPU nhiều core / GPU dư VRAM.
OCR_MAX_CONCURRENCY=1
# Warm-up model lúc startup để request đầu không bị chậm (chỉ hiệu lực khi real).
OCR_WARMUP_ON_STARTUP=true
OCR_RESULT_CACHE_ENABLED=true
OCR_RESULT_CACHE_TTL_SECONDS=86400
# Đọc QR mặt trước CCCD gắn chip (2021+): chính xác gần tuyệt đối cho số CCCD,
# họ tên, ngày sinh, giới tính, nơi thường trú. OCR vẫn chạy để bù trường QR
# không có (quốc tịch, quê quán, hạn) và làm fallback khi không có/đọc lỗi QR.
OCR_QR_ENABLED=true
OCR_ORIENTATION_RETRY=true
OCR_ORIENTATION_MODEL=PP-LCNet_x1_0_doc_ori

# ----- Image quality gate (pre-OCR) -----
# Lọc ảnh đạt/không đạt trước OCR. "hard" = chặn (không OCR); "soft" = vẫn OCR + cảnh báo.
QUALITY_CHECK_ENABLED=true
QUALITY_MAX_BATCH_FILES=20

# ----- Import PDF/HEIC + Job xử lý bất đồng bộ (POST /api/jobs) -----
IMPORT_MAX_FILE_MB=50
IMPORT_PDF_DPI=200
IMPORT_PDF_MAX_PAGES=100
IMPORT_SPLIT_MULTI_CARDS=true
JOB_MAX_ITEMS=200
JOB_TMP_DIR=tmp/jobs
# Ảnh gốc chỉ giữ trong thư mục tạm tối đa N phút, xóa ngay khi job xong.
JOB_TTL_MINUTES=60
JOB_RETENTION_DAYS=7
JOB_CLEANUP_INTERVAL_MINUTES=10
QUALITY_MIN_SIDE_HARD_PX=320
QUALITY_MIN_SIDE_SOFT_PX=640
QUALITY_BLUR_VAR_HARD=30.0
QUALITY_BLUR_VAR_SOFT=100.0
QUALITY_DARK_HARD=35.0
QUALITY_DARK_SOFT=65.0
QUALITY_BRIGHT_HARD=243.0
QUALITY_BRIGHT_SOFT=220.0
QUALITY_GLARE_HARD=0.30
QUALITY_GLARE_SOFT=0.12
# Kiểm tra "có phải thẻ CCCD" bằng YOLO (chỉ hiệu lực khi OCR_ENGINE=real).
# Dùng cùng retry thresholds của aligner để hạn chế false reject ảnh khó.
QUALITY_CARD_CHECK_ENABLED=true

# ----- Database -----
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./viescanner.db
DATABASE_ECHO=false

# ----- Scan retention (M5) -----
# Tự động xóa scan cũ hơn N ngày (0 = tắt, giữ toàn bộ lịch sử). Job chạy lúc
# startup và lặp lại mỗi SCAN_RETENTION_INTERVAL_HOURS giờ.
SCAN_RETENTION_DAYS=0
SCAN_RETENTION_INTERVAL_HOURS=24

# ----- Auth / JWT -----
# Keep false to preserve anonymous demo mode.
AUTH_REQUIRED=false
# Đặt chuỗi ngẫu nhiên dài (vd: python -c "import secrets;print(secrets.token_urlsafe(48))").
# Để CHANGE_ME thì server tự sinh khóa tạm, mọi phiên đăng nhập mất sau mỗi lần restart.
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MIN=60
JWT_REFRESH_EXPIRE_DAYS=7
