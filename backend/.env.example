# ===========================================
# VieScanner Backend - Environment Variables
# ===========================================
# Copy this file to `.env` and fill real values.
# Never commit `.env` to git.

# ----- App -----
APP_NAME=VieScanner API
APP_VERSION=1.0.0
DEBUG=true

# ----- CORS -----
CORS_ORIGINS_RAW=http://localhost:3000

# ----- Upload limits -----
MAX_UPLOAD_SIZE_MB=5
ALLOWED_MIME_TYPES_RAW=image/jpeg,image/png,image/webp

# ----- OCR engine -----
OCR_ENGINE=mock
OCR_DEVICE=auto
OCR_MODEL_DIR=weights
OCR_ALIGNER_CONF_THRESHOLD=0.25
OCR_ALIGNER_RETRY_CONF_THRESHOLDS_RAW=0.15,0.10,0.05
OCR_DETECTOR_MODEL=PP-OCRv5_server_det
OCR_DETECTOR_CONF_THRESHOLD=0.30
OCR_DETECTOR_PADDING=4
OCR_CLEANER_SHADOW_KERNEL_SIZE=7
OCR_CLEANER_CLIP_HIST_PERCENT=1.0
OCR_RECOGNIZER_MODEL=vgg_transformer
OCR_RECOGNIZER_BEAMSEARCH=true
OCR_EXTRACTOR_FUZZY_THRESHOLD=80
OCR_DEBUG_SAVE=false
OCR_MAX_IMAGE_SIDE_PX=2000
OCR_RESULT_CACHE_ENABLED=true
OCR_RESULT_CACHE_TTL_SECONDS=86400
# Đọc QR mặt trước CCCD gắn chip (2021+): chính xác gần tuyệt đối cho số CCCD,
# họ tên, ngày sinh, giới tính, nơi thường trú. OCR vẫn chạy để bù trường QR
# không có (quốc tịch, quê quán, hạn) và làm fallback khi không có/đọc lỗi QR.
OCR_QR_ENABLED=true

# ----- Image quality gate (pre-OCR) -----
# Lọc ảnh đạt/không đạt trước OCR. "hard" = chặn (không OCR); "soft" = vẫn OCR + cảnh báo.
QUALITY_CHECK_ENABLED=true
QUALITY_MAX_BATCH_FILES=20
QUALITY_MIN_SIDE_HARD_PX=320
QUALITY_MIN_SIDE_SOFT_PX=640
QUALITY_BLUR_VAR_HARD=30.0
QUALITY_BLUR_VAR_SOFT=100.0
QUALITY_DARK_HARD=35.0
QUALITY_DARK_SOFT=65.0
QUALITY_BRIGHT_HARD=243.0
QUALITY_BRIGHT_SOFT=220.0
QUALITY_GLARE_HARD=0.30
QUALITY_GLARE_SOFT=0.12
# Kiểm tra "có phải thẻ CCCD" bằng YOLO (chỉ hiệu lực khi OCR_ENGINE=real).
QUALITY_CARD_CHECK_ENABLED=true

# ----- Database -----
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./viescanner.db
DATABASE_ECHO=false

# ----- Auth / JWT -----
# Keep false to preserve anonymous demo mode.
AUTH_REQUIRED=false
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MIN=60
JWT_REFRESH_EXPIRE_DAYS=7
