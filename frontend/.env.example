# ===========================================
# VieScanner Frontend - Environment Variables
# ===========================================
# Copy this file to `.env.local` and fill real values.
# Never commit `.env.local` to git.

# Backend API base URL including /api
# Dev:  http://localhost:8000/api
# Prod: https://api.viescanner.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional upload optimization knobs
NEXT_PUBLIC_MAX_UPLOAD_SIDE_PX=2000
NEXT_PUBLIC_MIN_COMPRESS_BYTES=614400
NEXT_PUBLIC_UPLOAD_JPEG_QUALITY=0.9

# Tổng dung lượng tối đa mỗi lần gửi (MB), phải khớp MAX_REQUEST_MB của backend
NEXT_PUBLIC_MAX_REQUEST_MB=100
